{
  "TableFactory": {
    "sng": {
      "class": "SingleFastTable",
      "params": {
        "debugLevel": 2,
        "collectPropertiesMinLevel": -1,
        "needCompactOnOmitPropsCollector": false,
        "keyAnchorSizeUnit": "100K"
      }
    },
    "dispatch": {
      "class": "DispatcherTable",
      "params": {
        "auto_compaction_max_wamp": 100000000,
        "mark_for_compaction_max_wamp": 100000000,
        "trivial_move_always_max_output_level": 500,
        "trivial_move_max_file_size_multiplier": 40000,
        "default": "bb",
        "level_writers": [ "bb", "bb", "bb", "bb", "bb", "bb", "bb"]
      }
    }
  },
  "CFOptions": {
    "default": {
      "max_bytes_for_level_multiplier": 10,
      "max_bytes_for_level_multiplier_additional": [],
      "sst_partitioner_factory": "${rdb_partitioner}",
      "write_buffer_size": "8M",
      "max_write_buffer_size_to_maintain": "32M",
      "target_file_size_base": "1M",
      "target_file_size_multiplier": 1,
      "min_filter_level": -1,
      "memtable_factory": "${skiplist}"
    },
    "encrypt": {
      "sst_partitioner_factory": "${rdb_partitioner}",
      "min_filter_level": -1,
      "memtable_factory": "${skiplist}"
    },
    "default_sk": {
      "sst_partitioner_factory": "${rdb_partitioner}",
      "min_filter_level": -1,
      "memtable_factory": "${skiplist}"
    },
    "rev:order": {
      "max_bytes_for_level_multiplier": 10,
      "max_bytes_for_level_multiplier_additional": [],
      "sst_partitioner_factory": "${rdb_rev_partitioner}",
      "write_buffer_size": "2M",
      "max_write_buffer_size_to_maintain": "32M",
      "target_file_size_base": "2M",
      "target_file_size_multiplier": 1,
      "min_filter_level": -1,
      "memtable_factory": "${skiplist}"
    },
    "__tmp__": {
      "min_filter_level": -1,
      "memtable_factory": "${skiplist}"
    },
    "__tmp_system__": {
      "min_filter_level": -1,
      "memtable_factory": "${skiplist}"
    },
    "__system__": {
      "min_filter_level": -1,
      "memtable_factory": "${skiplist}"
    }
  },
  "CompactionExecutorFactory": {
    "dcompact": {
      "class": "DcompactEtcd",
      "params": {
        "dcompact_min_level": 20
      }
    }
  },
  "DBOptions": {
    "dbopt": {
      "db_log_dir": "",
      "max_background_flushes": -1,
      "max_background_compactions": -1,
      "max_subcompactions": 1,
      "max_level1_subcompactions": 1
    }
  },
  "//databases": {
    ".rocksdb": {
      "params": {
        "column_families": {
          "aaa": "${default}",
          "another_cf_for_p5": "${default}",
          "bar": "${default}",
          "baz": "${default}",
          "bbb": "${default}",
          "bf5_1": "${default}",
          "blah": "${default}",
          "ccc": "${default}",
          "cf" : "${default}",
          "cf-one": "${default}",
          "cf-zero": "${default}",
          "cf1": "${default}",
          "cf2": "${default}",
          "cf3": "${default}",
          "cf4": "${default}",
          "cf5": "${default}",
          "cf_a": "${default}",
          "cf_b": "${default}",
          "cf_c": "${default}",
          "cf_count_table": "${default}",
          "cf_i": "${default}",
          "cf_link": "${default}",
          "cf_link_id1_type": "${default}",
          "cf_link_pk": "${default}",
          "cf_long_prefix": "${default}",
          "cf_node": "${default}",
          "cf_node_type_id": "${default}",
          "cf_primary_key": "${default}",
          "cf_secondary_key": "${default}",
          "cf_short_prefix": "${default}",
          "cf_t1": "${default}",
          "cf_t3": "${default}",
          "foo": "${default}",
          "kb": "${default}",
          "kc": "${default}",
          "kl_cf":  "${default}",
          "lock_info_cf2": "${default}",
          "lock_into_cf1": "${default}",
          "my_cf0": "${default}",
          "my_cf1": "${default}",
          "my_custom_cf": "${default}",
          "new_cf0": "${default}",
          "new_cf1": "${default}",
          "notsharedcf": "${default}",
          "p0_cf": "${default}",
          "p1_cf": "${default}",
          "p3_cf": "${default}",
          "p4_cf": "${default}",
          "rev:": "${rev:order}",
          "rev:bar": "${rev:order}",
          "rev:bc": "${rev:order}",
          "rev:bf5_1": "${rev:order}",
          "rev:bf5_2": "${rev:order}",
          "rev:cf": "${rev:order}",
