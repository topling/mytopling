{
  "Cache": {
    "block_cache": {
      "class": "LRUCache",
      "params": {
        "capacity": "512M"
      }
    }
  },
  "TableFactory": {
    "sng": {
      "class": "SingleFastTable",
      "params": {
        "debugLevel": 2,
        "collectPropertiesMinLevel": -1,
        "needCompactOnOmitPropsCollector": false,
        "keyAnchorSizeUnit": "100K"
      }
    },
    "dispatch": {
      "class": "DispatcherTable",
      "params": {
        "auto_compaction_max_wamp": 100000000,
        "mark_for_compaction_max_wamp": 100000000,
        "trivial_move_always_max_output_level": 500,
        "trivial_move_max_file_size_multiplier": 40000,
        "default": "bb",
        "level_writers": [ "bb", "bb", "bb", "bb", "bb", "bb", "bb"]
      }
    }
  },
  "CFOptions": {
    "default": {
      "level_compaction_dynamic_level_bytes": true,
      "level_compaction_dynamic_file_size": true,
      "allow_merge_memtables": true,
      "disable_auto_compactions": false,
      "max_bytes_for_level_multiplier": 10,
      "max_bytes_for_level_multiplier_additional": [1,1,1,1,1,1,1],
      "max_compaction_bytes": 1677721600,
      "sst_partitioner_factory": "${rdb_partitioner}",
      "write_buffer_size": "8M",
      "max_write_buffer_size_to_maintain": "128K",
      "max_write_buffer_number": 2,
      "target_file_size_base": "64M",
      "target_file_size_multiplier": 1,
      "max_bytes_for_level_base": "256M",
      "soft_pending_compaction_bytes_limit": "64G",
      "hard_pending_compaction_bytes_limit": "256G",
      "min_filter_level": 0,
      "memtable_factory": "${skiplist}"
    },
    "encrypt": {
      "template": "${default}",
      "cf_paths": "/nvme-shared/mytopling/encrypt"
    },
    "default_sk": {
      "template": "${default}",
      "//cf_paths": "/nvme-shared/mytopling/default_sk"
    },
    "rev:order": {
      "template": "${default}",
      "sst_partitioner_factory": "${rdb_rev_partitioner}",
      "comparator": "${rev}"
    },
    "__tmp__": {
      "template": "${default}",
      "//cf_paths": "/nvme-shared/mytopling/__tmp__"
    },
    "__system__": {
      "disable_auto_compactions": false,
      "target_file_size_base": "64M",
      "target_file_size_multiplier": 1,
      "max_bytes_for_level_base": "256M",
      "max_compaction_bytes": 1677721600,
      "level_compaction_dynamic_level_bytes": true,
      "level_compaction_dynamic_file_size": true,
      "allow_merge_memtables": true,
      "paranoid_file_checks": false,
      "min_filter_level": 0,
      "memtable_factory": "${skiplist}"
    },
    "__tmp_system__": {
      "template": "${__system__}",
      "//cf_paths": "/nvme-shared/mytopling/__tmp_system__"
    },
    "sample": {
      "template": "default",
      "cf_paths": "/path/to/sample/cf"
    }
  },
  "CompactionExecutorFactory": {
    "dcompact": {
      "class": "DcompactEtcd",
      "params": {
        "dcompact_min_level": 20
      }
    }
  },
  "Statistics": {
    "stat": {
      "class": "default",
      "params": {
        "stats_level": "kExceptHistogramOrTimers"
      }
    }
  },
  "DBOptions": {
    "dbopt": {
      "db_log_dir": "",
      "info_log_level": "ERROR_LEVEL",
      "avoid_unnecessary_blocking_io": false,
      "allow_concurrent_memtable_write": false,
      "write_dbid_to_manifest": false,
      "verify_sst_unique_id_in_manifest": true,
      "enforce_single_del_contracts": false,
      "//create_missing_column_families": false,
      "delayed_write_rate": 0,
      "enable_thread_tracking": true,
      "enable_write_thread_adaptive_yield": false,
      "keep_log_file_num": 1000,
      "//periodic_compaction_seconds": 2592000,
      "stats_dump_period_sec": 600,
      "stats_persist_period_sec": 600,
      "max_log_file_size": 0,
      "max_background_flushes": -1,
      "max_background_compactions": -1,
      "max_subcompactions": 1,
      "max_level1_subcompactions": 0
    }
  },
  "//databases": {
    ".rocksdb": {
      "params": {
        "column_families": {
          "aaa": "${default}",
          "another_cf_for_p5": "${default}",
          "bar": "${default}",
          "baz": "${default}",
          "bbb": "${default}",
          "bf5_1": "${default}",
          "blah": "${default}",
          "ccc": "${default}",
          "cf" : "${default}",
          "cf-one": "${default}",
          "cf-zero": "${default}",
          "cf1": "${default}",
          "cf2": "${default}",
          "cf3": "${default}",
          "cf4": "${default}",
          "cf5": "${default}",
          "cf_a": "${default}",
          "cf_b": "${default}",
          "cf_c": "${default}",
          "cf_count_table": "${default}",
          "cf_i": "${default}",
          "cf_link": "${default}",
          "cf_link_id1_type": "${default}",
          "cf_link_pk": "${default}",
          "cf_long_prefix": "${default}",
          "cf_node": "${default}",
          "cf_node_type_id": "${default}",
          "cf_primary_key": "${default}",
          "cf_secondary_key": "${default}",
          "cf_short_prefix": "${default}",
          "cf_t1": "${default}",
          "cf_t3": "${default}",
          "foo": "${default}",
          "kb": "${default}",
          "kc": "${default}",
          "kl_cf":  "${default}",
          "lock_info_cf2": "${default}",
          "lock_into_cf1": "${default}",
          "my_cf0": "${default}",
          "my_cf1": "${default}",
          "my_custom_cf": "${default}",
          "new_cf0": "${default}",
          "new_cf1": "${default}",
          "notsharedcf": "${default}",
          "p0_cf": "${default}",
          "p1_cf": "${default}",
          "p3_cf": "${default}",
          "p4_cf": "${default}",
          "rev:": "${rev:order}",
          "rev:bar": "${rev:order}",
          "rev:bc": "${rev:order}",
          "rev:bf5_1": "${rev:order}",
          "rev:bf5_2": "${rev:order}",
          "rev:cf": "${rev:order}",
          "rev:cf1": "${rev:order}",
          "rev:cf2": "${rev:order}",
          "rev:cf_d": "${rev:order}",
          "rev:cf_i": "${rev:order}",
          "rev:cf_issue105": "${rev:order}",
          "rev:cf_link": "${rev:order}",
          "rev:cf_link_id1_type": "${rev:order}",
          "rev:cf_link_id1_type2": "${rev:order}",
          "rev:cf_link_id1_type3": "${rev:order}",
          "rev:cf_link_pk": "${rev:order}",
          "rev:cf_long_prefix": "${rev:order}",
          "rev:cf_short_prefix": "${rev:order}",
          "rev:cf_t2": "${rev:order}",
          "rev:cf_t4": "${rev:order}",
          "rev:foo": "${rev:order}",
          "rev:testrevcomment": "${rev:order}",
          "rev:x1": "${rev:order}",
          "sharedcf": "${default}",
          "t1-p0": "${default}",
          "t1-p2": "${default}",
          "test_cf": "${default}",
          "test_cf0": "${default}",
          "test_cf1": "${default}",
          "test_cf5": "${default}",
          "unique_test_cf5": "${default}",
          "z": "${default}",
          "zy_cf":  "${default}"
        }
      }
    }
  }
}
