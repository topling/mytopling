include/sync_slave_sql_with_master.inc
SET @handler_delete_on_slave =
(SELECT variable_value FROM performance_schema.global_status
WHERE variable_name = 'Handler_delete');
SET SESSION binlog_format = 'STATEMENT';
SET SESSION rocksdb_unsafe_for_binlog = 1;
SET @handler_delete_on_master =
(SELECT variable_value FROM performance_schema.global_status
WHERE variable_name = 'Handler_delete');
DELETE /*+ SET_VAR(rocksdb_use_range_del=ON) */
FROM t1 WHERE k BETWEEN 2 AND 4;
SELECT (SELECT variable_value FROM performance_schema.global_status
WHERE variable_name = 'Handler_delete') - @handler_delete_on_master
AS rows_deleted_one_by_one_on_master;
