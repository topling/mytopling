CREATE TABLE t9 (k INT NOT NULL, PRIMARY KEY (k)) ENGINE=rocksdb;
INSERT INTO t9 VALUES (1),(2),(3),(4),(5),(6);
CREATE FUNCTION f_del() RETURNS INT MODIFIES SQL DATA BEGIN DELETE FROM t9 WHERE k BETWEEN 2 AND 4; RETURN (SELECT COUNT(*) FROM t9 WHERE k BETWEEN 2 AND 4); END|
SET SESSION rocksdb_use_range_del = ON;
SELECT f_del();
f_del()
0
SET SESSION rocksdb_use_range_del = OFF;
SELECT GROUP_CONCAT(k ORDER BY k) FROM t9;
GROUP_CONCAT(k ORDER BY k)
1,5,6
DROP FUNCTION f_del;
