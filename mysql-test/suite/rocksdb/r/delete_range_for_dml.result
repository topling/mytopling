CREATE TABLE t11 (k INT NOT NULL, PRIMARY KEY (k)) ENGINE=rocksdb;
INSERT INTO t11 VALUES (1),(2),(3),(4),(5),(6),(7),(8);
DELETE /*+ SET_VAR(rocksdb_use_range_del=ON) */
FROM t11 WHERE k BETWEEN 3 AND 6;
SELECT ROW_COUNT();
ROW_COUNT()
10
SELECT GROUP_CONCAT(k ORDER BY k) FROM t11;
GROUP_CONCAT(k ORDER BY k)
1,2,7,8
# Kill and restart
SET SESSION sql_log_bin = 0;
SELECT GROUP_CONCAT(k ORDER BY k) FROM t11;
GROUP_CONCAT(k ORDER BY k)
1,2,7,8
SET SESSION debug = "d,crash_commit_before";
DELETE /*+ SET_VAR(rocksdb_use_range_del=ON) */
FROM t11 WHERE k BETWEEN 1 AND 2;
SET SESSION sql_log_bin = 0;
SELECT GROUP_CONCAT(k ORDER BY k) FROM t11;
GROUP_CONCAT(k ORDER BY k)
1,2,7,8
SET SESSION debug = "d,crash_commit_after";
DELETE /*+ SET_VAR(rocksdb_use_range_del=ON) */
FROM t11 WHERE k BETWEEN 1 AND 2;
SET SESSION sql_log_bin = 0;
SELECT GROUP_CONCAT(k ORDER BY k) FROM t11;
GROUP_CONCAT(k ORDER BY k)
7,8
