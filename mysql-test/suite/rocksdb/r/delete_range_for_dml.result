CREATE TABLE t3 (a INT NOT NULL, b INT NOT NULL, PRIMARY KEY (a,b)) ENGINE=rocksdb;
INSERT INTO t3 VALUES (1,1),(1,2),(1,3),(2,1),(2,2),(2,3),(3,1),(3,3);
DELETE /*+ SET_VAR(rocksdb_use_range_del=ON) */
FROM t3 WHERE a = 1 AND b > 2;
SELECT ROW_COUNT();
ROW_COUNT()
10
SELECT GROUP_CONCAT(CONCAT(a,':',b) ORDER BY a,b) FROM t3;
GROUP_CONCAT(CONCAT(a,':',b) ORDER BY a,b)
1:1,1:2,2:1,2:2,2:3,3:1,3:3
DELETE /*+ SET_VAR(rocksdb_use_range_del=ON) */
FROM t3 WHERE a >= 2 AND b = 3;
SELECT ROW_COUNT();
ROW_COUNT()
2
SELECT GROUP_CONCAT(CONCAT(a,':',b) ORDER BY a,b) FROM t3;
GROUP_CONCAT(CONCAT(a,':',b) ORDER BY a,b)
1:1,1:2,2:1,2:2,3:1
CREATE TABLE t4 (k INT NOT NULL, v INT, PRIMARY KEY (k), KEY v_idx (v))
ENGINE=rocksdb;
INSERT INTO t4 VALUES (1,10),(2,20),(3,30),(4,40),(5,50);
DELETE /*+ SET_VAR(rocksdb_use_range_del=ON) */
FROM t4 WHERE k BETWEEN 2 AND 4;
SELECT ROW_COUNT();
ROW_COUNT()
3
SELECT GROUP_CONCAT(k ORDER BY k) FROM t4;
GROUP_CONCAT(k ORDER BY k)
1,5
SELECT GROUP_CONCAT(v ORDER BY v) FROM t4 FORCE INDEX (v_idx) WHERE v > 0;
GROUP_CONCAT(v ORDER BY v)
10,50
CREATE TABLE t5_log (k INT) ENGINE=rocksdb;
CREATE TABLE t5 (k INT NOT NULL, v INT, PRIMARY KEY (k)) ENGINE=rocksdb;
INSERT INTO t5 VALUES (1,1),(2,2),(3,3),(4,4);
CREATE TRIGGER t5_bd BEFORE DELETE ON t5 FOR EACH ROW
INSERT INTO t5_log VALUES (OLD.k);
DELETE /*+ SET_VAR(rocksdb_use_range_del=ON) */
FROM t5 WHERE k BETWEEN 2 AND 3;
SELECT ROW_COUNT();
ROW_COUNT()
2
SELECT GROUP_CONCAT(k ORDER BY k) FROM t5_log;
GROUP_CONCAT(k ORDER BY k)
2,3
DROP TRIGGER t5_bd;
